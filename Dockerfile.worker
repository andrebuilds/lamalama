# Image for the job worker (npm run worker). The web app doesn't use it:
# Railway builds it with Railpack. The worker renders videos with Remotion,
# so it needs the system libraries of Chrome Headless Shell
# (remotion.dev/docs/docker), plus the source tree, which Remotion bundles
# at runtime.
FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    libnss3 libdbus-1-3 libatk1.0-0 libgbm-dev libasound2 libxrandr2 \
    libxkbcommon-dev libxfixes3 libxcomposite1 libxdamage1 \
    libatk-bridge2.0-0 libpango-1.0-0 libcairo2 libcups2 \
    fonts-noto-color-emoji \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY . .
# Dev dependencies included: the worker runs through tsx.
RUN npm ci
# Download Chrome Headless Shell now instead of on the first render.
RUN node -e "import('@remotion/renderer').then((r) => r.ensureBrowser())"

ENV NODE_ENV=production
CMD ["npm", "run", "worker"]
